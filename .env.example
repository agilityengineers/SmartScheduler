# SmartScheduler Local Development Environment
# Copy this file to .env and customize as needed

# Required: Session secret (any random string)
SESSION_SECRET=your-secret-key-change-this-in-production

# Optional: Force PostgreSQL usage (leave commented for in-memory storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/smartscheduler
# USE_POSTGRES=true

# Optional: Email configuration (for sending emails)
# SENDGRID_API_KEY=your-sendgrid-api-key
# FROM_EMAIL=noreply@yourdomain.com

# Optional: OAuth integrations (for calendar sync and video conferencing)
#
# Verify what the running server actually sees with:
#   GET /api/integrations/config-status   (authenticated)
# It reports, per provider, whether credentials are present and the exact
# redirect URI being sent - which must match the provider console byte for byte.

# Google Calendar
# Google Cloud console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Authorized redirect URI: {BASE_URL}/api/integrations/google/callback
# Requires the Google Calendar API to be enabled on the project. The
# .../auth/calendar scope is sensitive, so the OAuth consent screen must be
# published and verified before users outside your test-user list can connect.
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Outlook / Microsoft 365 Calendar
# Entra ID (Azure AD) > App registrations > your app
# Redirect URI (type "Web"): {BASE_URL}/api/integrations/outlook/callback
# Delegated Microsoft Graph permissions: offline_access, User.Read,
# Calendars.Read, Calendars.ReadWrite
# OUTLOOK_CLIENT_ID=your-outlook-client-id
# OUTLOOK_CLIENT_SECRET=your-outlook-client-secret

# Zoom
# Zoom Marketplace > your General/User-managed OAuth app
# Redirect URI + OAuth allow list: {BASE_URL}/api/integrations/zoom/callback
# Scopes are granted in the Marketplace app itself (not in the authorize
# request): meeting:write and user:read are both required.
# ZOOM_CLIENT_ID=your-zoom-client-id
# ZOOM_CLIENT_SECRET=your-zoom-client-secret
#
# Zoom webhook / deauthorization (REQUIRED to publish on the Zoom Marketplace).
# Marketplace > your app > Feature > Event Subscriptions.
#   Event notification endpoint:  {BASE_URL}/api/webhooks/zoom
#   Deauthorization endpoint:     {BASE_URL}/api/webhooks/zoom/deauthorize
# Subscribe to the "app_deauthorized" event. Copy the app's Secret Token here -
# it verifies the x-zm-signature header and answers Zoom's URL-validation
# challenge. Without it those requests are rejected (the endpoint fails closed).
# ZOOM_WEBHOOK_SECRET_TOKEN=your-zoom-secret-token
#
# Only for older Zoom apps that authenticate webhooks with a static
# verification token instead of a signature.
# ZOOM_VERIFICATION_TOKEN=your-zoom-verification-token
#
# NOTE: per-domain *_ALT credentials are no longer read by the server. All
# domains share one OAuth app per provider, so every domain users can reach the
# app on must be listed as an authorized redirect URI in that single app.

# Optional: Stripe (for subscriptions)
# STRIPE_SECRET_KEY=your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Optional: Enforce subscription/trial access on gated features (default off).
# When set to true, users without an active/trialing/past-due subscription,
# comped access, or an unexpired trial are blocked from gated actions (currently
# booking-link creation). Review the paywall policy before enabling.
# ENFORCE_SUBSCRIPTIONS=false

# Optional: Custom base URL (defaults to http://localhost:5000)
# BASE_URL=http://localhost:5000

# Optional: Encrypt stored calendar OAuth tokens / API keys at rest (AES-256-GCM).
# Must decode to 32 bytes: 64 hex chars, or base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When unset, tokens are stored as plaintext (backward compatible).
# ENCRYPTION_KEY=your-64-hex-char-key

# Optional: Max Postgres connections per instance (default 10). Keep this low
# enough that (PG_POOL_MAX * number_of_instances) stays under the database's
# connection limit on autoscale deployments.
# PG_POOL_MAX=10
